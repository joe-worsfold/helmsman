{
  "name": "helmsman",
  "displayName": "Helmsman",
  "description": "Helmsman standards, review, and delivery skills, the always-on rules, the agent watermark hook, and the lane cap hook.",
  "author": {
    "name": "Joe Worsfold",
    "url": "https://github.com/joe-worsfold"
  },
  "homepage": "https://github.com/joe-worsfold/helmsman",
  "repository": "https://github.com/joe-worsfold/helmsman",
  "license": "MIT",
  "skills": [
    "./.cursor/skills/"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/.helmsman/tools/claude/emit.sh --context",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/.helmsman/tools/watermark/hook.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|Agent|EnterWorktree)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/.helmsman/tools/lanes/lanes.sh hook",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
