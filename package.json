{
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=26.11.1"
  },
  "scripts": {
    "prepare": "lefthook install",
    "lint": "bash .helmsman/tools/checks/pnpm-task.sh lint",
