diff --git a/test/invoice.int.test.js b/test/invoice.int.test.js
new file mode 100644
index 0000000..b0e81b0
--- /dev/null
+++ b/test/invoice.int.test.js
@@ -0,0 +1,16 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import { consumeInvoice } from "../src/worker.js";
+
+test("acks a duplicate invoice job without sending twice", () => {
+  const sent = [];
+  const seen = new Set();
+  const job = { id: "inv-1", body: { id: "inv-1" }, seen };
+  const sink = (body) => sent.push(body);
+  const first = consumeInvoice(job, sink);
+  const second = consumeInvoice(job, sink);
+  assert.equal(first.acked, true);
+  assert.equal(first.duplicate, false);
+  assert.equal(second.duplicate, true);
+  assert.equal(sent.length, 1);
+});
