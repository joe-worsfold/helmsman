+import assert from "node:assert/strict";
+import test from "node:test";
+import { consume } from "../src/worker.js";
+
+test("invoice job reaches the sink once", () => {
+  const seen = new Set();
+  const got = [];
+  consume({ id: "1", body: "ok", seen }, (body) => got.push(body));
+  assert.deepEqual(got, ["ok"]);
+  const again = consume({ id: "1", body: "ok", seen }, (body) => got.push(body));
+  assert.equal(again.duplicate, true);
+  assert.deepEqual(got, ["ok"]);
+});
